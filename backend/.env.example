# App & Server Settings
PORT=8000
FRONTEND_URL=https://your-frontend-app.vercel.app
DOCUMENT_RETENTION_DAYS=15
ADMIN_SECRET=your-secure-admin-secret-token

# MongoDB Atlas Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ragify?retryWrites=true&w=majority
MONGO_TLS_INSECURE=false

# Firebase Admin Credentials
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Pinecone Vector DB
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=ragify-index

# Supabase Object Storage
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=ragify-files

# Groq LLM & Embeddings
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
